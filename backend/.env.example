# Backend Environment Variables
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/care2solutions

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
NOTIFICATION_EMAIL=sales@care2solution.com
FROM_EMAIL=Care2Solutions <noreply@care2solution.com>

# Cloudflare Turnstile CAPTCHA (leave unset for dev bypass)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
